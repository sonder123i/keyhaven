<Application x:Class="AiGateway.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiGateway.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <local:IsActiveConverter x:Key="IsActive" />
            <!--
              平铺成一条链，且 Tokens 放在最前面：换主题就是换掉这一个字典（见 App.xaml.cs 的 ApplySystemTheme）。
              三条字典里的引用都是 DynamicResource，所以顺序只影响「有重复键时谁赢」，而这里没有重复键。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
