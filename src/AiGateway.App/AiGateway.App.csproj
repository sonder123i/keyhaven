<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../AiGateway/AiGateway.csproj" />
    <ProjectReference Include="../AiGateway.Security/AiGateway.Security.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\keyhaven.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application/MessageBox; keep WinForms out of the global usings and import it only where the tray icon needs it. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="AiGateway.Tests" />
    <Resource Include="Assets\keyhaven.ico" />
  </ItemGroup>

</Project>
