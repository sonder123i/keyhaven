<Window x:Class="AiGateway.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 本地代理网关" Height="220" Width="460">
    <StackPanel Margin="24">
        <TextBlock Text="网关运行中" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="AddressText" Margin="0,8,0,0" FontFamily="Consolas" />
        <TextBlock Margin="0,16,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="关闭这个窗口只会隐藏到系统托盘，网关继续运行。要真正退出，请右键托盘图标选「退出」。" />
    </StackPanel>
</Window>
