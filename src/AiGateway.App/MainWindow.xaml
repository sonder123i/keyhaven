<Window x:Class="AiGateway.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="钥湾 Keyhaven" Icon="Assets/keyhaven.ico" Height="640" Width="940" MinHeight="520" MinWidth="820"
        IsVisibleChanged="OnVisibilityChanged"
        PreviewKeyDown="OnPreviewKeyDown"
        UseLayoutRounding="True"
        FontSize="{DynamicResource Type.Body}">
    <!-- 无边框：WindowChrome 让客户端延伸到标题栏位置，但保留原生的贴边/缩放/圆角/阴影。
         不用 WindowStyle=None（那会丢掉贴边与边缘缩放）。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid ClipToBounds="True">
        <!-- 底色层：玻璃「透出」的来源。只留一个几乎看不见的暖光斑（8%）落在右上角 —— 也就是主操作按钮那一侧；
             原来两个 20% / 18% 的大色斑是全应用最响的装饰，和「低调」正面冲突，已撤掉左下那个。 -->
        <Rectangle Fill="{DynamicResource Backdrop.Window}" />
        <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-240,-180,0"
                 Fill="{DynamicResource Backdrop.BlobAccent}" IsHitTestVisible="False" />

        <DockPanel>
        <!-- 自绘标题栏：整条可拖、双击最大化（CaptionHeight 交给系统）；三个窗口按钮标成可点 -->
        <Border DockPanel.Dock="Top" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource Ink.Muted}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{DynamicResource WindowControl}" Click="OnMinimizeWindow">
                        <Path Data="M 0,5 L 10,5" Stretch="None" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{DynamicResource WindowControl}" Click="OnToggleMaximize">
                        <Grid>
                            <Path x:Name="MaxGlyph" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stretch="None" StrokeThickness="1.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Path x:Name="RestoreGlyph" Data="M 2.5,0.5 L 9.5,0.5 L 9.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z"
                                  Stretch="None" StrokeThickness="1.2" Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{DynamicResource WindowControl.Close}" Click="OnCloseToTray">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stretch="None" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态脊：全窗唯一主信号。「现在跑在谁上面」占最高位，右侧是「切到谁」的目标。
             契约：常态状态用「细色条 + 文字」表达，不铺底色 —— 一整条彩色横条是全应用面积最大的色块，
             与「低调、只有一处该响」直接冲突；脊内那条 3px 左色条已足够承载状态语义。 -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1"
                Background="Transparent" BorderBrush="{DynamicResource Line.Default}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 状态靠这条 3px 竖色条承载（强色版，脱离底色也看得见）；它同时是可点区域，补一处中性悬停反馈 -->
                        <Border x:Name="IdentityBlock" Padding="10,2" BorderThickness="3,0,0,0"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnOpenProvidersTab"
                                ToolTip="点这里去「上游与 Key」页改它">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Status.Ok.Strong}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Activation.IsActive}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Status.Warn.Strong}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Surface.RowHover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前上游" Style="{DynamicResource Spine.Tag}" />
                                    <!-- 空态时这一格显示的是动作、不是陈述句，所以换品牌蓝；那格本来就是去「上游与 Key」的入口 -->
                                    <TextBlock Text="{Binding Activation.CurrentName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Spine.Name}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activation.IsActive}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Ink.Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="→" VerticalAlignment="Bottom" Margin="4,0,0,2"
                                               FontSize="{DynamicResource Type.Body}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Ink.Accent}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activation.IsActive}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Activation.CurrentModel}" Style="{DynamicResource Spine.Model}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Activation.CurrentNote}" Style="{DynamicResource Spine.Note}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 下拉各自带小标签：只写「切到」会让人分不清哪个框是哪个 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="切到" Style="{DynamicResource Spine.Tag}" VerticalAlignment="Center" />
                        <TextBlock Text="上游" Style="{DynamicResource Spine.Tag}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ActiveProvider" Width="150"
                                  ItemsSource="{Binding Activation.Providers}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding Activation.SelectedProvider}" />
                        <TextBlock Text="模型" Style="{DynamicResource Spine.Tag}" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <ComboBox x:Name="ActiveModel" Width="170" IsEditable="True"
                                  ItemsSource="{Binding Activation.Models}"
                                  Text="{Binding Activation.SelectedModel, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="ActivateButton" Content="切换" Margin="12,0,0,0" Click="OnActivate" Style="{DynamicResource Button.Accent}"
                                IsEnabled="{Binding Activation.CanSwitch}"
                                ToolTip="选一个与当前不同的上游（或换个模型）之后才可点" />
                    </StackPanel>
                </Grid>

                <!-- 失败/提示：带边框的警示块 + "下一步做什么"，不是容易被划过的一行红字 -->
                <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Status.Danger.Background}" BorderBrush="{DynamicResource Status.Danger.Line}" BorderThickness="1"
                        Visibility="{Binding Activation.HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="ActivationMessage" Text="{Binding Activation.Message}" Foreground="{DynamicResource Ink.Danger}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Chrome}" Padding="8,2"
                   BorderBrush="{DynamicResource Line.Rim}" BorderThickness="0,1,0,0">
            <!-- 运行态信息归页脚：网关地址 / 代理密钥可用数（原在绿框里那行，别再占脊的高度） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Foreground="{DynamicResource Ink.Muted}" />
                <TextBlock x:Name="ProxyKeyText" Grid.Column="1" Margin="16,0,0,0"
                           Foreground="{DynamicResource Ink.Subtle}" Text="{Binding Activation.ProxyKeyText}" />
            </Grid>
        </StatusBar>

        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged" Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem x:Name="ProvidersTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <!-- 线宽沿用自绘标题栏那套 1.2px；描边绑 TabItem.Foreground，所以选中时图标跟着标签一起变品牌蓝 -->
                        <Path Width="16" Height="16" Stretch="None" StrokeThickness="1.2" VerticalAlignment="Center"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Data="M 2,8.5 A 1.5,1.5 0 1 1 5,8.5 A 1.5,1.5 0 1 1 2,8.5 M 11,8.5 A 1.5,1.5 0 1 1 14,8.5 A 1.5,1.5 0 1 1 11,8.5 M 5,8.5 L 11,8.5" />
                        <TextBlock Text="上游与 Key" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- 主从并排：左边列表满高、右边编辑器自己滚 —— 选中与编辑同时可见。
                     原来表单堆在列表下方，选中一行后列表会被滚出视野，最小高度 520 时尤其难受。 -->
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <!-- 左边只放「认出这是哪一家」要用的信息：全称表（6 列 845px）在最小窗口下必然横向滚动 -->
                        <ListView x:Name="ProviderList" ItemsSource="{Binding Providers.Rows}" SelectedItem="{Binding Providers.Selected}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <!-- 本地模板而不是 GridView 那套滚动样式：这列表用的是 ItemTemplate、不是 GridView 列，
                                 外观与其它列表一致（发丝边 + 卡片圆角），但不带表头plumbing。 -->
                            <ListView.Template>
                                <ControlTemplate TargetType="ListView">
                                    <Border CornerRadius="{DynamicResource Radius.Card}" Background="Transparent"
                                            BorderBrush="{DynamicResource Line.Default}" BorderThickness="1" ClipToBounds="True">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ListView.Template>
                            <!--
                              行容器必须自己给一份：Controls.xaml 里那个隐式 ListViewItem 样式的模板写死了
                              GridViewRowPresenter（配 GridView 用的），配 ItemTemplate 时它会拿到空的列集合、
                              整行画不出东西 —— 行高只剩内边距（实测 5px），左侧面板看起来就是一大块空白。
                            -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Foreground" Value="{DynamicResource Ink.Primary}" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        BorderBrush="{DynamicResource Line.Default}" BorderThickness="0,0,0,1">
                                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.RowHover}" />
                                                    </Trigger>
                                                    <!-- 选中行 = 右边正在编辑的那一条，用淡蓝选中底把关系说清楚 -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.RowSelected}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="3" VerticalAlignment="Center"
                                                        Background="{DynamicResource Surface.RowSelected}">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource IsActive}">
                                                            <Binding Path="Config.Id" />
                                                            <Binding Path="DataContext.Activation.ActiveProviderId" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                    <TextBlock Text="使用中" FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource Ink.Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{DynamicResource Hint}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding KeyText}" Style="{DynamicResource Data}" Margin="8,1,0,0"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource Ink.Muted}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空状态：不摆空列表，直接给三步 + 一个按钮（方向指向右边，编辑器现在在右侧） -->
                        <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Line.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}"
                                Visibility="{Binding Providers.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="20" VerticalAlignment="Center">
                                <TextBlock Text="还没有上游。三步就好：" FontWeight="SemiBold" />
                                <TextBlock Style="{DynamicResource Hint}" Text="① 点右边的「新建」，用「一键预设」选一家 —— 类型和地址会自动填好" />
                                <TextBlock Style="{DynamicResource Hint}" Text="② 填上模型名，点「保存」，再把这家厂家的 Key 粘进去" />
                                <TextBlock Style="{DynamicResource Hint}" Text="③ 回到最上面「一键切换」里选它 —— 之后 Claude Code 就通过它说话" />
                                <Button Content="① 新建一个上游" Margin="0,14,0,0" HorizontalAlignment="Left" Click="OnNewProvider" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <!-- 三层：上游（这是谁）/ 连接与凭据（怎么连）/ 模型（用哪个）；各段自己的按钮贴在段尾 -->
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                        <TextBlock Text="上游" Style="{DynamicResource Form.Section}" />
                        <Border Height="1" Margin="0,3,0,6" Background="{DynamicResource Line.Default}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="一键预设" Style="{DynamicResource FieldLabel}" />
                            <StackPanel Grid.Column="1" Margin="0,2">
                                <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch" MaxWidth="380"
                                          ItemsSource="{Binding Providers.Presets}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding Providers.SelectedPreset}" />
                                <TextBlock Style="{DynamicResource Hint}" Text="选一家会自动填好类型和地址。"
                                       ToolTip="选一家会替你填好类型与地址（只收厂家本体；地址只写核实过的，未核实的会标出来）。模型名留给你确认。" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="名称" Style="{DynamicResource FieldLabel}" />
                            <TextBox x:Name="ProviderName" Grid.Row="1" Grid.Column="1" Text="{Binding Providers.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

                            <TextBlock Grid.Row="2" Text="类型" Style="{DynamicResource FieldLabel}" />
                            <ComboBox x:Name="ProviderKind" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="260" Margin="0,2"
                                      ItemsSource="{Binding Providers.Kinds}" DisplayMemberPath="Text" SelectedValuePath="Kind"
                                      SelectedValue="{Binding Providers.Kind}" />

                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="NewProviderButton" Content="新建" Click="OnNewProvider" />
                                <Button x:Name="SaveProviderButton" Content="保存上游" Margin="8,0,0,0" Click="OnSaveProvider" />
                                <Button x:Name="DeleteProviderButton" Content="删除" Margin="8,0,0,0" Click="OnDeleteProvider" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="连接与凭据" Style="{DynamicResource Form.Section}" Margin="0,12,0,0" />
                        <Border Height="1" Margin="0,3,0,6" Background="{DynamicResource Line.Default}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="地址" Style="{DynamicResource FieldLabel}" />
                            <StackPanel Grid.Column="1" Margin="0,2">
                                <TextBox x:Name="ProviderUrl" Text="{Binding Providers.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{DynamicResource Hint}" Text="本机以外必须用 https。"
                                       ToolTip="填 API 根，网关自己追加后缀（OpenAI 类追加 /chat/completions，Anthropic 类追加 /v1/messages）。本机以外必须用 https。" />
                            </StackPanel>

                            <!-- 编辑器现在只有约 380px 宽：Key 框与三个按钮拆成两行，不然窄窗下会挤出去 -->
                            <TextBlock Grid.Row="1" Text="Key" Style="{DynamicResource FieldLabel}" Margin="0,10,12,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                <PasswordBox x:Name="KeyBox" Width="300" HorizontalAlignment="Left" IsEnabled="{Binding Providers.CanSaveKey}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="SaveKeyButton" Content="保存 Key" Click="OnSaveKey" IsEnabled="{Binding Providers.CanSaveKey}" />
                                    <Button x:Name="ProbeButton" Content="测试连接" Margin="8,0,0,0" Click="OnProbe" IsEnabled="{Binding Providers.CanSaveKey}" />
                                    <Button x:Name="FetchModelsButton" Content="拉取模型" Margin="8,0,0,0" Click="OnFetchModels" IsEnabled="{Binding Providers.CanSaveKey}" />
                                </StackPanel>
                                <TextBlock Style="{DynamicResource Hint}" Text="Key 只存本机 DPAPI 密文，保存后输入框立即清空。"
                                       ToolTip="Key 用 Windows DPAPI 加密后只存在本机；保存后输入框立即清空。两个诊断按钮都经上游客户端发出 —— Key 照旧只在注入处理器里解密。「测试连接」只探地址通不通，「拉取模型」只对 OpenAI 类上游有效。" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="模型" Style="{DynamicResource Form.Section}" Margin="0,12,0,0" />
                        <Border Height="1" Margin="0,3,0,6" Background="{DynamicResource Line.Default}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型" Style="{DynamicResource FieldLabel}" />
                            <StackPanel Grid.Column="1" Margin="0,2">
                                <TextBox x:Name="ProviderModels" Text="{Binding Providers.Models, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Name="ModelHintText" Style="{DynamicResource Hint}" Text="{Binding Providers.ModelHint}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ProvidersMessage" Text="{Binding Providers.Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Message}">
                                    <Style.Triggers>
                                        <!-- 失败不再和成功共用一种品牌蓝：只有需要你处理的才换告警色 -->
                                        <DataTrigger Binding="{Binding Providers.MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Ink.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="ProxyKeysTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="None" StrokeThickness="1.2" VerticalAlignment="Center"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Data="M 3.3,5.5 A 2.2,2.2 0 1 1 7.7,5.5 A 2.2,2.2 0 1 1 3.3,5.5 M 7.05,7.05 L 12.6,12.6 M 11,11 L 12.8,9.2" />
                        <TextBlock Text="代理密钥" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="标签" Style="{DynamicResource FieldLabel}" />
                        <TextBox x:Name="NewKeyLabel" Width="220" Text="{Binding ProxyKeys.NewLabel, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="GenerateKeyButton" Content="生成新密钥" Margin="8,0,0,0" Click="OnGenerateKey" />
                    </StackPanel>

                    <ListView x:Name="ProxyKeyList" Grid.Row="1" Margin="0,12,0,0"
                              ItemsSource="{Binding ProxyKeys.Rows}" SelectedItem="{Binding ProxyKeys.Selected}">
                        <ListView.View>
                            <GridView>
                                <!-- 列宽按内容实测收：指纹只有 8 位十六进制，创建时间 16 字符。
                                     原合计 820 在最小窗口（内容区约 780）下必然横向滚动。 -->
                                <GridViewColumn Header="标签" Width="230" DisplayMemberBinding="{Binding Label}" />
                                <!-- 指纹是十六进制、要逐位核对：等宽（和「新的代理密钥」窗里排配置片段同一套字） -->
                                <GridViewColumn Header="指纹" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Fingerprint}" Style="{DynamicResource Data}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="100" DisplayMemberBinding="{Binding StatusText}" />
                                <GridViewColumn Header="创建时间" Width="220" DisplayMemberBinding="{Binding CreatedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RevokeKeyButton" Content="吊销所选" Click="OnRevokeKey" />
                        <Button x:Name="DeleteKeyButton" Content="删除所选" Margin="8,0,0,0" Click="OnDeleteKey" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Style="{DynamicResource Hint}" Margin="0,10,0,0"
                                   Text="代理密钥是发给客户端的可吊销凭证，不是上游 Key。"
                                   ToolTip="代理密钥是发给客户端（Claude Code、ZCode 等）的、可随时吊销的访问凭证，不是你的上游 Key。明文只在生成时显示一次，这里只显示指纹。吊销立即生效且不可恢复。" />
                        <TextBlock x:Name="ProxyKeysMessage" Text="{Binding ProxyKeys.Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Message}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProxyKeys.MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Ink.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="RunLogTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="None" StrokeThickness="1.2" VerticalAlignment="Center"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Data="M 3.5,4.5 L 12.5,4.5 M 3.5,8 L 12.5,8 M 3.5,11.5 L 9,11.5" />
                        <TextBlock Text="运行日志" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 不要「刷新」按钮：本页可见时每秒自动拉一次（见 MainWindow.xaml.cs 的 _logTimer），按钮纯属冗余 chrome -->
                    <TextBlock Text="日志只在内存里，重启清空；不记内容与密钥，只显指纹。本页可见时每秒自动更新。"
                               ToolTip="最近请求（最新在上）。日志只在内存里，重启清空；不记录请求内容、响应内容和任何密钥，只显示指纹。"
                               Style="{DynamicResource Hint}" VerticalAlignment="Center" />

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <ListView x:Name="RunLogList" ItemsSource="{Binding RunLog.Rows}">
                            <ListView.View>
                                <GridView>
                                    <!-- 列宽按内容实测收：原合计 840 在最小窗口（内容区约 780）下必然横向滚动 -->
                                    <GridViewColumn Header="时间" Width="80" DisplayMemberBinding="{Binding Time}" />
                                    <GridViewColumn Header="密钥指纹" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Fingerprint}" Style="{DynamicResource Data}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="上游" Width="130" DisplayMemberBinding="{Binding Provider}" />
                                    <GridViewColumn Header="模型" Width="170" DisplayMemberBinding="{Binding Model}" />
                                    <!-- 出错的行只让「状态」这一格变红：日志要一眼扫出问题，但整行铺色会把表格变成花纹 -->
                                    <GridViewColumn Header="状态" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Ink.Danger}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="首字节" Width="80" DisplayMemberBinding="{Binding FirstByte}" />
                                    <GridViewColumn Header="结束原因" Width="105" DisplayMemberBinding="{Binding Outcome}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 空态：不摆空表头（看起来像渲染中断），直接一句话 + 下一步 -->
                        <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Line.Default}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Visibility="{Binding RunLog.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="还没有请求。" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{DynamicResource Hint}" HorizontalAlignment="Center"
                                           Text="把客户端指向上面的地址发一次请求，这里就会多一条记录。" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="RunLogStatus" Grid.Row="2" Margin="0,8,0,0" Text="{Binding RunLog.Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Ink.Subtle}" />
                                <Style.Triggers>
                                    <!-- 空表时这句与上面的说明重复，直接不占位 -->
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="None" StrokeThickness="1.2" VerticalAlignment="Center"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              Data="M 3.5,5 L 12.5,5 M 6.5,3.2 L 6.5,6.8 M 3.5,11 L 12.5,11 M 10,9.2 L 10,12.8" />
                        <TextBlock Text="设置" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!--
                  原来这里是一张「左对齐 + 宽度封顶 720」的卡：横向设了对齐、纵向没设，
                  默认 Stretch 把卡撑满整页 —— 于是右边一条、卡内下方一块全是无主空白。
                  这一页只有四行真信息，和另外三个页签一样直接铺在底色上，宽度交给 * 列吸收。
                  接入片段单独限宽 600：代码块太宽，反而会把空白圈进边框里。
                -->
                <Grid Margin="14,12,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="监听地址" Style="{DynamicResource FieldLabel}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Settings.Address}" Style="{DynamicResource Data}" FontSize="15"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Ink.Primary}" />
                        <Button x:Name="CopyAddressButton" Content="复制" Padding="10,3" MinWidth="52" Margin="12,0,0,0"
                                Click="OnCopyAddress" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="端口" Style="{DynamicResource FieldLabel}" Margin="0,14,12,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBox x:Name="PortBox" Width="100" FontFamily="Consolas" Text="{Binding Settings.PortText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="SavePortButton" Content="保存" Margin="8,0,0,0" Click="OnSavePort" />
                    </StackPanel>

                    <!-- 接入配置：给一段真 JSON，而不是把地址塞进一句散文里 —— 用户要的就是能直接抄进 settings.json 的东西 -->
                    <TextBlock Grid.Row="2" Text="接入配置" Style="{DynamicResource FieldLabel}" VerticalAlignment="Top" Margin="0,18,12,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,18,0,0" ToolTip="{Binding Settings.AddressText}">
                        <TextBox Text="{Binding Settings.AddressSnippet, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" Padding="6"
                                 MaxWidth="600" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="复制这段" Padding="10,3" MinWidth="76" Click="OnCopySnippet" />
                            <TextBlock Style="{DynamicResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="地址固定为本机 127.0.0.1，只有端口可改；token 用你在「代理密钥」页生成的那把（明文只在生成时显示一次）。" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="版本" Style="{DynamicResource FieldLabel}" Margin="0,14,12,0" />
                    <TextBlock x:Name="VersionText" Grid.Row="3" Grid.Column="1" Margin="0,14,0,0" VerticalAlignment="Center"
                               Style="{DynamicResource Data}" Foreground="{DynamicResource Ink.Muted}" />

                    <TextBlock x:Name="SettingsMessage" Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Settings.Message}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Message}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Ink.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
        </TabControl>
        </DockPanel>
    </Grid>
</Window>