<Window x:Class="AiGateway.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 本地代理网关" Height="640" Width="940" MinHeight="520" MinWidth="820"
        IsVisibleChanged="OnVisibilityChanged"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7785" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Message" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F4E79" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F5F8" BorderBrush="#DDE2E8" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="一键切换" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="上游" Margin="16,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="ActiveProvider" Width="180"
                              ItemsSource="{Binding Activation.Providers}" DisplayMemberPath="Name"
                              SelectedItem="{Binding Activation.SelectedProvider}" />
                    <TextBlock Text="模型" Margin="16,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="ActiveModel" Width="220" IsEditable="True"
                              ItemsSource="{Binding Activation.Models}"
                              Text="{Binding Activation.SelectedModel, UpdateSourceTrigger=PropertyChanged}" />
                    <Button x:Name="ActivateButton" Content="切换" Margin="12,0,0,0" Click="OnActivate" />
                </StackPanel>

                <!-- 主状态：一眼可见。没激活上游时整块变告警色 —— 别让"当前用的是谁"藏在一行灰字里 -->
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EAF3EA" />
                            <Setter Property="BorderBrush" Value="#B7D7B7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Activation.IsActive}" Value="False">
                                    <Setter Property="Background" Value="#FFF4E5" />
                                    <Setter Property="BorderBrush" Value="#E8B457" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock x:Name="ActiveText" Text="{Binding Activation.CurrentText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProxyKeyText" Margin="0,4,0,0" Style="{StaticResource Hint}" Text="{Binding Activation.ProxyKeyText}" />
                    </StackPanel>
                </Border>

                <!-- 失败/提示：带边框的警示块 + "下一步做什么"，不是容易被划过的一行红字 -->
                <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="4" Background="#FDECEA" BorderBrush="#F3B6AE" BorderThickness="1"
                        Visibility="{Binding Activation.HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="ActivationMessage" Text="{Binding Activation.Message}" Foreground="#B42318" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" />
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="12" SelectionChanged="OnTabChanged">
            <TabItem x:Name="ProvidersTab" Header="上游与 Key">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <ListView x:Name="ProviderList" ItemsSource="{Binding Providers.Rows}" SelectedItem="{Binding Providers.Selected}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="130" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="类型" Width="170" DisplayMemberBinding="{Binding KindText}" />
                                    <GridViewColumn Header="地址" Width="270" DisplayMemberBinding="{Binding BaseUrl}" />
                                    <GridViewColumn Header="模型" Width="170" DisplayMemberBinding="{Binding ModelsText}" />
                                    <GridViewColumn Header="Key" Width="70" DisplayMemberBinding="{Binding KeyText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 空状态：不摆空表格，直接给三步 + 一个按钮 -->
                        <Border Background="#FAFBFC" BorderBrush="#DDE2E8" BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding Providers.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="24" VerticalAlignment="Center">
                                <TextBlock Text="还没有上游。三步就好：" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" Text="① 点下面的「新建」，用「一键预设」选一家 —— 类型和地址会自动填好" />
                                <TextBlock Style="{StaticResource Hint}" Text="② 填上模型名，点「保存」，再在下面把这家厂家的 Key 粘进去" />
                                <TextBlock Style="{StaticResource Hint}" Text="③ 回到最上面「一键切换」里选它 —— 之后 Claude Code 就通过它说话" />
                                <Button Content="① 新建一个上游" Margin="0,14,0,0" HorizontalAlignment="Left" Click="OnNewProvider" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="一键预设" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1" Margin="0,2">
                            <ComboBox x:Name="PresetBox" Width="380" HorizontalAlignment="Left"
                                      ItemsSource="{Binding Providers.Presets}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding Providers.SelectedPreset}" />
                            <TextBlock Style="{StaticResource Hint}" Text="选一家会替你填好类型与地址（只收厂家本体；地址只写核实过的，未核实的会标出来）。模型名留给你确认。" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="名称" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ProviderName" Grid.Row="1" Grid.Column="1" Text="{Binding Providers.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

                        <TextBlock Grid.Row="2" Text="类型" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProviderKind" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="260" Margin="0,2"
                                  ItemsSource="{Binding Providers.Kinds}" DisplayMemberPath="Text" SelectedValuePath="Kind"
                                  SelectedValue="{Binding Providers.Kind}" />

                        <TextBlock Grid.Row="3" Text="地址" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                            <TextBox x:Name="ProviderUrl" Text="{Binding Providers.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="填 API 根，网关自己追加后缀（OpenAI 类追加 /chat/completions，Anthropic 类追加 /v1/messages）。本机以外必须用 https。" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="模型" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                            <TextBox x:Name="ProviderModels" Text="{Binding Providers.Models, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Name="ModelHintText" Style="{StaticResource Hint}" Text="{Binding Providers.ModelHint}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="NewProviderButton" Content="新建" Click="OnNewProvider" />
                            <Button x:Name="SaveProviderButton" Content="保存" Margin="8,0,0,0" Click="OnSaveProvider" />
                            <Button x:Name="DeleteProviderButton" Content="删除" Margin="8,0,0,0" Click="OnDeleteProvider" />
                        </StackPanel>

                        <TextBlock Grid.Row="6" Text="Key" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <PasswordBox x:Name="KeyBox" Width="300" IsEnabled="{Binding Providers.CanSaveKey}" />
                                <Button x:Name="SaveKeyButton" Content="保存 Key" Margin="8,0,0,0" Click="OnSaveKey" IsEnabled="{Binding Providers.CanSaveKey}" />
                                <Button x:Name="ProbeButton" Content="测试连接" Margin="8,0,0,0" Click="OnProbe" IsEnabled="{Binding Providers.CanSaveKey}" />
                                <Button x:Name="FetchModelsButton" Content="拉取模型" Margin="8,0,0,0" Click="OnFetchModels" IsEnabled="{Binding Providers.CanSaveKey}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Key 用 Windows DPAPI 加密后只存在本机；保存后输入框立即清空。两个诊断按钮都经上游客户端发出 —— Key 照旧只在注入处理器里解密。「测试连接」只探地址通不通，「拉取模型」只对 OpenAI 类上游有效。" />
                        </StackPanel>

                        <TextBlock x:Name="ProvidersMessage" Grid.Row="7" Grid.Column="1" Style="{StaticResource Message}" Text="{Binding Providers.Message}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="ProxyKeysTab" Header="代理密钥">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="标签" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NewKeyLabel" Width="220" Text="{Binding ProxyKeys.NewLabel, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="GenerateKeyButton" Content="生成新密钥" Margin="8,0,0,0" Click="OnGenerateKey" />
                    </StackPanel>

                    <ListView x:Name="ProxyKeyList" Grid.Row="1" Margin="0,12,0,0"
                              ItemsSource="{Binding ProxyKeys.Rows}" SelectedItem="{Binding ProxyKeys.Selected}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="标签" Width="200" DisplayMemberBinding="{Binding Label}" />
                                <GridViewColumn Header="指纹" Width="120" DisplayMemberBinding="{Binding Fingerprint}" />
                                <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding StatusText}" />
                                <GridViewColumn Header="创建时间" Width="160" DisplayMemberBinding="{Binding CreatedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RevokeKeyButton" Content="吊销所选" Click="OnRevokeKey" />
                        <Button x:Name="DeleteKeyButton" Content="删除所选" Margin="8,0,0,0" Click="OnDeleteKey" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="代理密钥是发给客户端（Claude Code、ZCode 等）的、可随时吊销的访问凭证，不是你的上游 Key。明文只在生成时显示一次，这里只显示指纹。吊销立即生效且不可恢复。" />
                        <TextBlock x:Name="ProxyKeysMessage" Style="{StaticResource Message}" Text="{Binding ProxyKeys.Message}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="RunLogTab" Header="运行日志">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="最近请求（最新在上）。日志只在内存里，重启清空；不记录请求内容、响应内容和任何密钥，只显示指纹。"
                                   Style="{StaticResource Hint}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Button x:Name="RefreshLogButton" Content="刷新" Click="OnRefreshLog" />
                    </StackPanel>

                    <ListView x:Name="RunLogList" Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding RunLog.Rows}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="80" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="密钥指纹" Width="100" DisplayMemberBinding="{Binding Fingerprint}" />
                                <GridViewColumn Header="上游" Width="130" DisplayMemberBinding="{Binding Provider}" />
                                <GridViewColumn Header="模型" Width="170" DisplayMemberBinding="{Binding Model}" />
                                <GridViewColumn Header="状态" Width="60" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="首字节" Width="80" DisplayMemberBinding="{Binding FirstByte}" />
                                <GridViewColumn Header="结束原因" Width="110" DisplayMemberBinding="{Binding Outcome}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="RunLogStatus" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray" Text="{Binding RunLog.Status}" />
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="设置">
                <StackPanel Margin="16">
                    <TextBlock x:Name="AddressText" Text="{Binding Settings.AddressText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PortBox" Width="100" Text="{Binding Settings.PortText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="SavePortButton" Content="保存" Margin="8,0,0,0" Click="OnSavePort" />
                    </StackPanel>
                    <TextBlock x:Name="SettingsMessage" Style="{StaticResource Message}" Text="{Binding Settings.Message}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>