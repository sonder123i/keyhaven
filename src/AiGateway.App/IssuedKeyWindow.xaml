<Window x:Class="AiGateway.App.IssuedKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新的代理密钥" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="13"
        Background="{DynamicResource Backdrop.Window}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="{DynamicResource Type.Title}" FontWeight="SemiBold" />

        <!-- 四段说明原来同字号同灰度，「只显示这一次」只靠红字区分，很容易被当免责声明划过去。
             现在只有这一条是高亮块，其余降成 Hint。 -->
        <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="{DynamicResource Radius.Card}"
                Background="{DynamicResource Status.Danger.Background}"
                BorderBrush="{DynamicResource Status.Danger.Line}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Ink.Danger}"
                       Text="这把密钥只显示这一次。关掉这个窗口后，网关只保留它的哈希，再也看不到明文。" />
        </Border>

        <TextBlock Style="{DynamicResource Hint}" Margin="0,12,0,6" MaxWidth="600"
                   Text="把下面这段合并进 Claude Code 的 ~/.claude/settings.json，或在终端里设置同名环境变量。这是一把可随时吊销的访问凭证，不是你的上游 Key。" />
        <TextBox x:Name="SnippetBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" Padding="6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatus" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Ink.Accent}" />
            <!-- 主操作是「复制」：这个窗口的全部意义就是把这段拿走 -->
            <Button x:Name="CopyButton" Content="复制配置片段" Padding="14,4" Style="{DynamicResource Button.Accent}" Click="OnCopy" />
            <Button x:Name="CloseButton" Content="我已保存，关闭" Padding="14,4" Margin="8,0,0,0" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
