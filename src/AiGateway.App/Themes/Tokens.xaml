<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      语义 token：按含义命名，不按颜色命名 —— 换风格只改这里的值，业务 XAML 不动。

      玻璃填充规则对齐教务 app 的 glassSurfaceColor()（亮色 White α0.90 / 压在深色内容上 0.62 /
      高对比 0.96）。角色表里的 surfaceAlpha 0.16/0.10/0.08 是配 backdrop 模糊用的，本工程不做
      backdrop 采样，照搬会压掉文字可读性，因此只取「填充 + 描边 + 阴影」这一层。

      已知缺口：自定义模板不再走系统高对比度调色板（WPF 默认控件会走）。要补需要把所有 token
      引用从 StaticResource 改成 DynamicResource，才能让运行时的 HC 覆盖字典生效；当前未做。
    -->

    <!-- 窗口底色层（「透出」的来源；非系统材质，不依赖未公开 API） -->
    <LinearGradientBrush x:Key="Backdrop.Window" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6EDF6" Offset="0" />
        <GradientStop Color="#F8FBFE" Offset="0.52" />
        <GradientStop Color="#E9F1F8" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Backdrop.BlobAccent" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#161F4E79" Offset="0" />
        <GradientStop Color="#001F4E79" Offset="1" />
    </RadialGradientBrush>

    <!-- 玻璃表面：悬浮的导航 / 控制 / 模态层用它；内容卡片不进材质系统 -->
    <SolidColorBrush x:Key="Surface.Glass" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="Surface.Chrome" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Surface.Card" Color="#F2FFFFFF" />
    <!-- 内容层：空态卡要盖住底下的空表，必须不透明；玻璃只用于导航/控制/模态 -->
    <SolidColorBrush x:Key="Surface.Content" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Surface.Control" Color="#B8FFFFFF" />
    <!-- 输入类要压得住文字，比普通控件更不透明 -->
    <SolidColorBrush x:Key="Surface.Input" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Surface.ControlHover" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Surface.ControlPressed" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="Surface.ControlDisabled" Color="#5EFFFFFF" />
    <SolidColorBrush x:Key="Surface.Popup" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="Surface.RowHover" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="Surface.RowSelected" Color="#CCDCE9F7" />

    <!-- 玻璃描边：暗发丝定义边界 + 白色高光做"薄玻璃"的上沿 -->
    <SolidColorBrush x:Key="Line.Default" Color="#140F1B2A" />
    <SolidColorBrush x:Key="Line.Rim" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="Line.Control" Color="#2E7C93A8" />
    <SolidColorBrush x:Key="Line.Accent" Color="#661F4E79" />
    <!-- 滚动条拇指：原来硬编码在 Controls.xaml 里，是全工程唯一没 token 化的颜色 -->
    <SolidColorBrush x:Key="Line.ScrollThumb" Color="#807C93A8" />

    <!--
      无边框标题栏那三个窗口按钮的悬停/按下底色。原来是黑 α、硬编码在 Controls.xaml 的 Style.Resources 里，
      并靠同名键覆盖派生样式 —— 黑 α 一旦落到深色标题栏上就等于看不见，所以提到 token 层随主题走。
      关闭按钮仍在自己 Style.Resources 里覆盖成红色（那红色在深浅两种底色上都成立，不必进主题）。
    -->
    <SolidColorBrush x:Key="WindowControl.Hover" Color="#140F1B2A" />
    <SolidColorBrush x:Key="WindowControl.Pressed" Color="#2E0F1B2A" />

    <!-- 文字层级 -->
    <SolidColorBrush x:Key="Ink.Primary" Color="#1B2735" />
    <SolidColorBrush x:Key="Ink.Muted" Color="#5C6875" />
    <SolidColorBrush x:Key="Ink.Accent" Color="#1F4E79" />
    <SolidColorBrush x:Key="Ink.Subtle" Color="#68727F" />
    <SolidColorBrush x:Key="Ink.Danger" Color="#B42318" />
    <SolidColorBrush x:Key="Ink.Disabled" Color="#9AA4B0" />

    <!--
      状态语义：绿=已激活 / 琥珀=未激活 / 红=失败。
      .Strong 是「细色条 / 状态点」用的强色：常态不铺底色，色条要自己在中性底上站住，
      所以按 WCAG 非文本对比 3:1 取值（原 .Line 那档淡色是配底色用的，脱离底色就看不见了）。
      .Background / .Line 只留给「需要用户处理」的告警块 —— 不透明才压得住告警对比度。
    -->
    <SolidColorBrush x:Key="Status.Ok.Strong" Color="#3E8A53" />
    <SolidColorBrush x:Key="Status.Ok.Line" Color="#B7D7B7" />
    <SolidColorBrush x:Key="Status.Warn.Strong" Color="#B67C16" />
    <SolidColorBrush x:Key="Status.Warn.Line" Color="#E8B457" />
    <SolidColorBrush x:Key="Status.Danger.Background" Color="#FDECEA" />
    <SolidColorBrush x:Key="Status.Danger.Line" Color="#F3B6AE" />

    <!-- 阴影：教务 Modal 角色 shadowAlpha 0.24，按桌面尺寸收敛 -->
    <DropShadowEffect x:Key="Shadow.Panel" BlurRadius="18" ShadowDepth="2" Direction="270" Color="#1B2A3C" Opacity="0.18" />
    <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="14" ShadowDepth="3" Direction="270" Color="#1B2A3C" Opacity="0.22" />

    <!-- 度量：教务 24dp 卡片 / 16dp 行圆角是触屏尺度，桌面按 13px 字号收敛 -->
    <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <Thickness x:Key="Space.Block">16,12</Thickness>
    <sys:Double x:Key="Type.Body">13</sys:Double>
    <sys:Double x:Key="Type.Title">18</sys:Double>
    <sys:Double x:Key="Type.Caption">12</sys:Double>
</ResourceDictionary>