// ai-gateway.request-flow.dot
// 一次 /v1/messages 请求的生命周期（2026-10-15 按 review 决策重写）。
// 关键变化：路由之后分两条路 —— 上游原生说 Anthropic 协议就直通（只改 model 字段），否则翻译（第二里程碑）。
// 红色 = 失败 / 终止分支，刻意画出来。
digraph AiGatewayRequestFlow {
    rankdir=TB;
    nodesep=0.35;
    ranksep=0.5;
    fontname="Sans-Serif";
    labelloc=t;
    fontsize=13;
    label="一次 /v1/messages 请求的生命周期\n客户端只持【代理密钥】；路由只来自【激活快照】(D7)\n【真实 Key】只在注入处理器里解密、只在最后一条出边上离开进程";

    node [fontname="Sans-Serif", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#4a5b6c"];
    edge [fontname="Sans-Serif", fontsize=9];

    client [label="Claude Code\nANTHROPIC_BASE_URL=http://127.0.0.1:端口号\nANTHROPIC_AUTH_TOKEN=代理密钥\nPOST /v1/messages?beta=true", shape=hexagon, fillcolor="#cfd8e3"];
    untrusted [label="本机不受信来源\n任意网页 / DNS rebinding / 其他本机程序", shape=hexagon, fillcolor="#f7dada", color="#b91c1c"];

    ingress [label="Kestrel：只绑 127.0.0.1（D9），端口可改\n/v1/messages · /v1/messages/count_tokens · /health", fillcolor="#dfeaf7"];
    verify  [label="代理密钥验证\nx-api-key 或 Authorization: Bearer\nSHA-256 → 与已启用哈希的内存快照 FixedTimeEquals\n快照随配置写入整体替换：吊销即刻生效，不每请求读盘", fillcolor="#ffe9b8"];
    v401    [label="401（Anthropic 错误体形状）", fillcolor="#f7dada", color="#b91c1c"];

    resolve [label="路由解析：读激活快照（D7）\n→ 上游类型 · BaseUrl · 真实模型名", fillcolor="#dfeaf7"];
    rFail   [label="无激活档 / 上游未配置 Key\n→ Anthropic 形状错误", fillcolor="#f7dada", color="#b91c1c"];

    pass    [label="直通（M1）\n请求体只改顶层 model，其余原样（thinking / cache_control 照带）\n转发 anthropic-version · anthropic-beta · 原查询串\ncount_tokens 同样直通；上游不支持就回它的 404", fillcolor="#d8f0e6"];
    xlate   [label="翻译（M2，仅 OpenAI 上游）\nAnthropic 请求 → chat/completions\n带 stream_options.include_usage；thinking 丢弃（D4）\ncount_tokens 直接 404，客户端自行估算", style="rounded,filled,dashed", fillcolor="#ece4f7"];

    client_http [label="上游 HTTP 客户端（AiGateway）\n只在请求选项里设 provider id\n代码不经手真实 Key", fillcolor="#dfeaf7"];
    inject  [label="注入处理器（AiGateway.Security，DelegatingHandler）\n按 provider id 取密文 → DPAPI 解密 → 写鉴权头\n全工程唯一解密点；不构造、不发起请求", fillcolor="#f7dada"];
    dpapi   [label="Windows DPAPI\nCurrentUser + 该 Provider 的 entropy", shape=circle, style=filled, fillcolor="#b8860b", fontcolor="#ffffff"];
    cfg     [label="config.json\nKey 只有 DPAPI 密文 · 代理密钥只有 SHA-256", shape=folder, style=filled, fillcolor="#4d6fa8", fontcolor="#ffffff"];

    upstream [label="上游\nAnthropic 兼容：api.anthropic.com · api.deepseek.com/anthropic\nOpenAI：api.openai.com（M2）", shape=hexagon, style=filled, fillcolor="#999999", fontcolor="#ffffff"];
    upErr   [label="上游 4xx / 5xx\n状态码与错误体原样透传，不重试不降级（D4）\nM1 验收实测：上游错误体只回显打码后的 Key 片段", fillcolor="#f7dada", color="#b91c1c"];

    passBack [label="直通回流\nSSE 字节原样逐块写回并 flush", fillcolor="#d8f0e6"];
    xlateBack [label="翻译回流（M2）\nOpenAI chunk → 工具调用增量重编码 → Anthropic 事件\nmessage_delta 合成 usage", style="rounded,filled,dashed", fillcolor="#ece4f7"];
    abort   [label="客户端中止（Ctrl+C / ESC / 断连）\n→ 必须取消上游请求，否则连接泄漏、上游继续计费", fillcolor="#f7dada", color="#b91c1c"];
    runLog  [label="运行日志（内存环形缓冲，一行一请求）\n时间 · 代理密钥指纹 · 上游 · 模型 · 状态 · 首字节耗时 · 中止原因\n不含请求体 / 响应内容 / 任何密钥明文", fillcolor="#d8f0e6"];

    guard [label="不变式\n① 真实 Key 只在注入处理器里解密，只沿 上游客户端 → 上游 这一条边离开进程\n② 代理密钥明文不进日志 / 异常消息 / 配置文件（日志只收指纹类型）\n③ IRealKeyVault 只写，签名上拿不到明文\n④ 直通必须转发 anthropic-version / anthropic-beta（官方网关协议要求）", shape=note, style="rounded,filled", fillcolor="#fff4cc"];
    threat [label="代理密钥的真实职责（更正旧版理由）\n监听写死 127.0.0.1 挡不住本机浏览器里的网页与其他程序；\n高熵代理密钥 + 鉴权正是挡它们的那道门。\nDPAPI CurrentUser 防不住以本人身份运行的恶意程序。", shape=note, style="rounded,filled,dashed", fillcolor="#e6edf7"];

    client -> ingress [color="#1f6f5c", penwidth=2];
    untrusted -> ingress [color="#b91c1c", style=dashed, label="能发请求"];
    ingress -> verify [color="#1f6f5c", penwidth=2];
    verify -> resolve [label="通过", color="#1f6f5c", penwidth=2];
    verify -> v401 [label="未知 / 已禁用 / 不匹配", color="#b91c1c", style=dashed];
    resolve -> pass [label="上游说 Anthropic 协议", color="#1f6f5c", penwidth=2];
    resolve -> xlate [label="上游只说 OpenAI", style=dashed];
    resolve -> rFail [color="#b91c1c", style=dashed];
    pass -> client_http [color="#1f6f5c", penwidth=2];
    xlate -> client_http [style=dashed];
    client_http -> inject [label="经过管道", color="#1f6f5c", penwidth=2];
    cfg -> inject [label="密文", style=dashed];
    dpapi -> inject [label="解密", style=dashed, color="#a33b3b"];
    inject -> upstream [label="★ 真实 Key 在此离开进程", color="#b91c1c", penwidth=3];
    upstream -> passBack [label="直通", color="#1f6f5c", penwidth=2];
    upstream -> xlateBack [label="翻译", style=dashed];
    upstream -> upErr [color="#b91c1c", style=dashed];
    passBack -> client [label="SSE 增量", color="#1f6f5c", penwidth=2, constraint=false];
    xlateBack -> client [style=dashed, constraint=false];
    passBack -> abort [color="#b91c1c", style=dashed];
    abort -> upstream [label="取消（唯一一条反向控制边）", color="#b91c1c", style=dashed, constraint=false];

    passBack -> runLog [style=dotted, constraint=false];
    v401 -> runLog [style=dotted, constraint=false];
    upErr -> runLog [style=dotted, constraint=false];
    inject -> guard [style=dotted, color="#e08a00", constraint=false];
    untrusted -> threat [style=dotted, color="#3a6ea5", constraint=false];
}
