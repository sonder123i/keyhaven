// ai-gateway.dependencies.dot
// 程序集依赖与护栏（2026-10-15 按 review 决策重写：10 个程序集收成 3 个产品程序集 + 1 个测试项目）。
// 读法：实线 = 编译期引用；虚线 = 运行时装配；红色虚线 = 禁止边（禁令，不是现状），constraint=false 不参与分层。
// 设计意图：只给"密钥"这一条脊柱留编译期边界；其余边界靠 internal 可见性 + 一个小测试文件。
digraph AiGatewayDeps {
    rankdir=TB;
    nodesep=0.5;
    ranksep=0.8;
    fontname="Sans-Serif";
    labelloc=t;
    label="AI 本地代理网关 —— 程序集依赖与护栏（target-state）\n只有 AiGateway.Security 能解密；AiGateway 在编译期就看不见它";

    node [fontname="Sans-Serif", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#4a5b6c"];
    edge [fontname="Sans-Serif", fontsize=9];

    App [label="AiGateway.App（WinExe, net8.0-windows, WPF）\n组合根 · 托盘 · 四类页面 · ViewModels\n调用 AddAiGateway() + AddAiGatewaySecurity()", fillcolor="#e6edf7"];

    Lib [label="AiGateway（classlib, net8.0）\n入口 · 代理密钥验证 · 激活快照 · 路由\n直通转发 · 翻译(M2) · 上游客户端 · 配置存储 · 运行日志\n对外只公开 AddAiGateway()、IRealKeyVault（只写）、ICiphertextStore（只存取密文），其余 internal", fillcolor="#dfeaf7"];

    Sec [label="AiGateway.Security（classlib, net8.0-windows）\nDPAPI 保护器 · 只写密钥库(IRealKeyVault 实现)\n真实密钥注入处理器(DelegatingHandler)\n对外只公开 AddAiGatewaySecurity()，其余 internal", fillcolor="#f7dada"];

    Tests [label="AiGateway.Tests（xUnit）\nInternalsVisibleTo 两个库\n护栏测试：引用断言 + 解密点计数 + Security 不发请求", style="rounded,filled,dashed", fillcolor="#fff4cc"];

    Pkg [label="System.Security.Cryptography\n.ProtectedData（NuGet）\n只有 Security 引用", shape=component, fillcolor="#eeeeee"];
    AspNet [label="Microsoft.AspNetCore.App\n（FrameworkReference）", shape=component, fillcolor="#eeeeee"];
    Upstream [label="上游（Anthropic 兼容 / OpenAI）", shape=hexagon, style=filled, fillcolor="#999999", fontcolor="#ffffff"];

    // ---------- 编译期引用（现状目标） ----------
    App -> Lib [label="compile-time", color="#1f6f5c", penwidth=2];
    App -> Sec [label="compile-time（只能见到注册方法）", color="#1f6f5c", penwidth=2];
    Sec -> Lib [label="compile-time：取/写密文的存储端口、请求选项键名", color="#1f6f5c", penwidth=2];
    Sec -> Pkg [label="唯一引用者"];
    Lib -> AspNet [label="Kestrel / Minimal API"];
    Tests -> App [style=dotted, label="test-only"];
    Tests -> Lib [style=dotted];
    Tests -> Sec [style=dotted];

    // ---------- 运行时装配 ----------
    Sec -> Lib [label="runtime：注入处理器挂进上游 HttpClient 管道\n（组合根装配，没有任何代码调用它）", style=dashed, color="#b91c1c", penwidth=2, constraint=false];
    Lib -> Upstream [label="runtime HTTPS\n★ 真实 Key 只在这条边上离开进程", style=dashed, color="#b91c1c", penwidth=2];

    // ---------- 禁止边（禁令，由编译器或护栏测试拦截） ----------
    Lib -> Sec [label="FORBIDDEN-06/07：网关、鉴权、日志\n在编译期看不见解密能力\n（引用方向唯一：Security → AiGateway）", color="#b91c1c", style=dashed, constraint=false];
    Lib -> Pkg [label="FORBIDDEN：AiGateway 引用 ProtectedData\n（加了也会因 net8.0 目标被 CA1416 拦）", color="#b91c1c", style=dashed, constraint=false];
    Sec -> Upstream [label="FORBIDDEN-09：Security 自己发请求\n不得用 HttpClient / IHttpClientFactory /\nSocketsHttpHandler / HttpClientHandler，\n不得构造 HttpRequestMessage", color="#b91c1c", style=dashed, constraint=false];

    guard [label="护栏（全部在 AiGateway.Tests 一个文件里）\n① AiGateway.csproj 无 Security 引用，且程序集元数据不引用它\n   （编译期另有两道：net8.0 引 net8.0-windows → NU1201；反向成环 → MSB4006）\n② 全 src 里 ProtectedData.Unprotect 恰好 1 处（SecretProtector）；S5 起它只被注入处理器调用\n③ Security 源码里不出现发请求的类型（base.SendAsync 除外）\n④ IRealKeyVault 没有任何返回明文的成员\n其余边界靠 internal：App 只能看到注册方法与两个端口（越界即 CS0122）", shape=note, style="rounded,filled", fillcolor="#fff4cc"];
    Tests -> guard [style=dotted, constraint=false];
}
